# Development: allow phones/tablets on the same LAN to access the dev server.
# Replace with your machine's local IP (run `hostname -I` on Linux, `ipconfig` on Windows).
# Comma-separated list if you have multiple devices.
ALLOWED_DEV_ORIGINS=192.168.68.60

# Google Calendar - Service Account
# Obtener en: console.cloud.google.com → IAM y administración → Cuentas de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=mi-service-account@mi-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Gmail SMTP
# Requiere verificación en 2 pasos activada en la cuenta Gmail.
# Obtener en: myaccount.google.com → Seguridad → Contraseñas de aplicación
GMAIL_USER=labarberia@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Panel de administración (/admin) — providers y services en SQLite.
# DATABASE_PATH debe apuntar a un volumen persistente en producción
# (si no, cada redeploy borra la base y las fotos subidas).
DATABASE_PATH=./data/app.db
# Clave para firmar las cookies de sesión — generar una distinta por negocio,
# ej. con `openssl rand -base64 32`.
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Usuario/contraseña dummy sembrados en el primer arranque (npm run db:migrate).
# Cámbialos desde /admin/account apenas entres la primera vez.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=cambiame123

# Límites de /admin, opcionales — si no se setean, quedan en 8 y 5.
MAX_GALLERY_IMAGES=8
MAX_PROVIDERS=5
